# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Anthropic API key for the extraction and analysis passes.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model used by the pipeline. Pin it — silent model changes change output.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional reasoning effort per stage (default medium; transcription uses the
# grounding effort). ANTHROPIC_PROMPT_CACHE=off|system|on (default off).
ANTHROPIC_EFFORT_GROUNDING=
ANTHROPIC_EFFORT_EXTRACTION=
ANTHROPIC_EFFORT_JUDGING=
ANTHROPIC_PROMPT_CACHE=

# Cap spend per analysis run while developing (SEK). Pipeline should abort
# rather than exceed this.
MAX_COST_PER_ANALYSIS_SEK=5

# Supabase — server-side only. NEVER VITE_-prefixed (Vite injects those into
# the client bundle). The secret key bypasses RLS entirely — never send it
# to the browser.
#
# Named PROJECT_* rather than SUPABASE_*: the web app is published on
# Lovable, and Lovable's Secrets manager (More → Cloud → Secrets) refuses
# any secret name starting with SUPABASE_. `supabase secrets set` refuses
# it too. Set the SAME names — PROJECT_URL, PROJECT_SECRET_KEY,
# PROJECT_PUBLISHABLE_KEY — in Lovable's Secrets so all three runtimes
# (this file, Lovable, the Edge Function) agree.
PROJECT_URL=https://<project>.supabase.co
PROJECT_SECRET_KEY=                # sb_secret_... — server only
PROJECT_PUBLISHABLE_KEY=           # used only by the RLS verification script, never shipped to the browser in Phase 1

# Global daily spend cap (SEK) and kill switch. The per-run cap above limits
# one analysis; these limit the day.
MAX_DAILY_SPEND_SEK=200
ANALYSIS_KILL_SWITCH=off

# Edge Function only (Supabase secrets): the key pg_cron sends when it calls
# analys-steg. Must match the Vault secret `automations_key`.
AUTOMATIONS_KEY=

# Supabase CLI only (never used at runtime) — personal access token for
# `supabase link` / `db push` / `functions deploy` / `secrets set`.
SUPABASE_ACCESS_TOKEN=

# Listing prefill on /analysera ("Hämta uppgifter", web app only; docs/booli.md,
# docs/plans/booli-api.md). ANNONS_HAMTNING=off turns everything off.
ANNONS_HAMTNING=
# Booli REST API keys (both needed; absent = the API path is skipped).
# Server only, never VITE_-prefixed. A key lasts ~3 months.
BOOLI_CALLER_ID=
BOOLI_PRIVATE_KEY=
# BOOLI_API=off switches the API off (default on when both keys are set).
BOOLI_API=
# ANNONS_SIDHAMTNING=on adds the listing-page fetch as a fallback (default off;
# Cloudflare-challenged in production).
ANNONS_SIDHAMTNING=
# ANNONS_LLM_FALLBACK=on: Haiku fallback when the listing page can't be parsed.
ANNONS_LLM_FALLBACK=
